# Copy to .env and fill in. NEVER commit .env.
# Inside Docker Compose, hosts "db" and "redis" are set by docker-compose.yml.
# The URLs below are for running tools directly on your machine.

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- Database ---
# Runtime role (non-superuser, Row Level Security enforced)
DATABASE_URL=postgresql+psycopg://agent_app:agent_app@localhost:5432/agentplatform
# Owner role, used only by Alembic migrations
MIGRATION_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/agentplatform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase Auth (Phase 2) ---
# Project URL, e.g. https://abcdefgh.supabase.co  (API: used to verify tokens, no secret needed)
SUPABASE_URL=
# Same URL and the PUBLISHABLE key for the browser. The API reuses the same publishable key
# (it reads SUPABASE_PUBLISHABLE_KEY, or this variable) to confirm emails with Supabase. The publishable key is safe to expose;
# never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- LLM provider (Phase 3) ---
# Get a free Gemini key at https://aistudio.google.com (Get API key). Keep it in .env only.
GEMINI_API_KEY=
# "free": Google may use your prompts to improve its products. Use fake or public data only.
# Set to "paid" only after enabling billing on the key's Google Cloud project.
GEMINI_TIER=free
# Estimated USD per million tokens, per model (JSON). Optional: without it, costs show as 0 and
# agents with a cost budget cannot run. Copy real numbers from the provider's pricing page.
# MODEL_PRICES={"gemini-3.5-flash": {"input_per_mtok": "<USD>", "output_per_mtok": "<USD>"}}
# Seconds to wait for one model call.
# LLM_TIMEOUT_SECONDS=60
# Anthropic is supported by the design but not enabled yet.
# ANTHROPIC_API_KEY=

# --- Credential encryption (Phase 4; generate a key, see docs) ---
CREDENTIAL_ENCRYPTION_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=
