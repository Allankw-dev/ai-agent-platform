# Copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- Database (local Docker Postgres by default) ---
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/agentplatform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase (Phase 2) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Anthropic (Phase 3) ---
ANTHROPIC_API_KEY=

# --- Credential encryption (generate a 32-byte key; see docs) ---
CREDENTIAL_ENCRYPTION_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=
